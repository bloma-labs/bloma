# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
npm-debug.log*

# Rust and Anchor build output. The IDL is committed under idl/ deliberately;
# everything else here is regenerated by a build.
target/
.anchor/
test-ledger/
*.so

# Deploy material. The program and deploy keypairs belong to the project owner
# and are never checked in.
deploy-keypair*.json

# Environment and secrets. Never commit a populated environment file.
.env
.env.*
!.env.example
*.pem
*.key
id.json
*-keypair.json
